{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "MinGW Release (Ninja)",
      "description": "Standard release build preset using MinGW GCC and Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "E:/Programm/w64devkit/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "E:/Programm/w64devkit/bin/g++.exe"
      },
      "environment": {
        "PATH": "E:/Programm/w64devkit/bin;E:/Programm/Python/Scripts;E:/Programm/Git/cmd;$penv{PATH}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "displayName": "Build Release",
      "configurePreset": "default",
      "configuration": "Release"
    }
  ]
}
